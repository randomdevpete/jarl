{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    // Off deliberately: checking the published .d.ts files is the point of this project.
    "skipLibCheck": false,
    "types": ["vitest/globals"]
  },
  "include": ["src"]
}
