{
  "name": "jarl-react-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Playwright e2e suite for jarl-react v2, plus a minimal Vite fixture app that renders the draft v2 route atoms. This is a TEST FIXTURE only, not the real demo/docs site (see ticket 58).",
  "type": "module",
  "scripts": {
    "dev": "vite --config fixture-app/vite.config.ts",
    "build": "vite build --config fixture-app/vite.config.ts",
    "preview": "vite preview --config fixture-app/vite.config.ts",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jotai": "^2.20.2",
    "jotai-location": "^0.6.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  }
}
