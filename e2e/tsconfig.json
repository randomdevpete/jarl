{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "jarl-atoms": ["../packages/jarl-atoms/src/index.ts"],
      "jarl-react": ["../packages/jarl-react/src/index.ts"]
    }
  },
  "include": ["fixture-app/src", "tests", "playwright.config.ts"]
}
