{
  "branches": ["master", { "name": "beta", "prerelease": true }],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "breaking": true, "release": "minor" },
          { "type": "feat", "release": "patch" },
          { "type": "revert", "release": "patch" }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "./scripts/reject-burned-versions.mjs",
      {
        "versions": ["2.1.0", "2.2.0", "2.3.0", "2.4.0", "2.5.0"]
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    "./scripts/pin-internal-deps.mjs",
    [
      "@semantic-release/npm",
      {
        "pkgRoot": "packages/jarl-atoms"
      }
    ],
    [
      "@semantic-release/npm",
      {
        "pkgRoot": "packages/jarl-react"
      }
    ],
    "./scripts/update-lockfile.mjs",
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "package-lock.json",
          "packages/jarl-atoms/package.json",
          "packages/jarl-react/package.json",
          "packages/docs/package.json"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    "@semantic-release/github"
  ]
}
