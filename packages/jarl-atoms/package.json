{
    "name": "jarl-atoms",
    "version": "2.0.0",
    "description": "JARL: Atomic Routing Library - framework-agnostic routing atoms",
    "keywords": [
        "atoms",
        "history",
        "jotai",
        "router",
        "routing",
        "ssr",
        "url"
    ],
    "license": "MIT",
    "author": "Peter Hurst",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/downplay/jarl-react.git"
    },
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -b && rolldown -c",
        "watch": "rolldown -c -w",
        "clean": "rm -rf dist",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "jotai": "^2.20.2",
        "jotai-location": "^0.6.2"
    },
    "devDependencies": {
        "jsdom": "^30.0.1",
        "rolldown": "^1.2.3",
        "rolldown-plugin-dts": "^0.28.0",
        "typescript": "^6.0.3",
        "vitest": "^4.1.10"
    }
}
