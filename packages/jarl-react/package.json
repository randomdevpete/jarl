{
  "name": "jarl-react",
  "version": "2.3.0",
  "description": "JARL: Atomic Routing Library - React bindings for jarl-atoms",
  "keywords": [
    "components",
    "history",
    "hooks",
    "jotai",
    "react",
    "reactjs",
    "router",
    "routing",
    "ssr",
    "url"
  ],
  "license": "MIT",
  "author": "Peter Hurst",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/randomdevpete/jarl.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b && rolldown -c",
    "watch": "rolldown -c -w",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci-test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src --max-warnings 0"
  },
  "dependencies": {
    "jarl-atoms": "2.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jotai": "^2.20.2",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rolldown": "^1.2.3",
    "rolldown-plugin-dts": "^0.28.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "jotai": "^2.0.0",
    "react": "^18.0.0 || ^19.0.0"
  }
}
